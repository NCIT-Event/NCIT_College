  "narrative": {
    "northStar": "The Well-Kept Institution",
    "overview": "A classic university website, played straight at the craft level of harvard.edu and mit.edu: a photography-led banner, clear mega-menus, editorial news, events and notices, leadership messages, and an apply band. NCIT's identity comes from its emblem. Royal blue is the institution, Om red is the call to apply, and sky blue is a quiet accent on dark grounds. Everything else is white, a cool canvas grey, and thin rules.",
    "keyCharacteristics": [
      "Serif display (Source Serif 4, optical sizes) over a humanist sans (Mukta, Devanagari-ready for a Nepali toggle).",
      "Divided lists and 1px rules instead of card grids.",
      "Red is reserved for Apply and destructive or urgent states.",
      "Every photo is a named slot under `assets/img/photos/`, with a labelled placeholder until the real file exists.",
      "Invented content always carries the amber Sample marker."
    ],
    "rules": [
      {
        "name": "The Red Means Apply Rule",
        "body": "Om red appears only on Apply buttons, urgent banners, destructive actions and exam tags. Never as decoration or a section ground.",
        "section": "colors"
      },
      {
        "name": "The Brand Lives in One File Rule",
        "body": "Brand hexes are estimated from the emblem image until the college confirms them; every page reads them from the `@theme` block in `frontend/src/css/site.css`, so confirming them is a one-file change.",
        "section": "colors"
      },
      {
        "name": "The Serif Speaks First Rule",
        "body": "Headings are serif and sentence case; UI, meta and body text are Mukta. Dashboards use the serif only for the page title.",
        "section": "typography"
      }
    ],
    "dos": [
      "**Do** take brand colours from the tokens; never hard-code hexes in pages.",
      "**Do** mark every invented name, date, figure, quote and photo with the Sample marker.",
      "**Do** give every image an intended file path and alt text, so real photos drop in without code changes.",
      "**Do** keep Om red for Apply, urgent and destructive actions.",
      "**Do** use divided lists and rules for collections of items."
    ],
    "donts": [
      "**Don't** put a small uppercase label above a heading.",
      "**Don't** use coloured side bars thicker than 1px on list items, nav links or callouts.",
      "**Don't** build pages from grids of identical icon cards.",
      "**Don't** redraw or restyle the NCIT emblem; use the supplied file.",
      "**Don't** present invented statistics (placement rates, rankings, student counts) as fact."
    ]
  }
