# Copy with `python3 infra/setup_env.py` (generates the secrets below). Never commit .env.

# --- Secrets (generated) ---
SECRET_KEY=
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
POSTGRES_PASSWORD=
AUTH_DB_PASSWORD=
AUDIT_DB_PASSWORD=
ACADEMICS_DB_PASSWORD=
CONTENT_DB_PASSWORD=
EVENTS_DB_PASSWORD=
ECA_DB_PASSWORD=
NOTIFY_DB_PASSWORD=
ADMISSIONS_DB_PASSWORD=
CAREERS_DB_PASSWORD=
ALUMNI_DB_PASSWORD=
SEARCH_DB_PASSWORD=

# --- Google sign-in (Google Cloud console > APIs & Services > Credentials) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match an "Authorized redirect URI" on the OAuth client exactly.
OAUTH_REDIRECT_URI=http://localhost:8080/api/v1/auth/google/callback

# --- Email (applicant codes and status emails) ---
# Without SMTP_HOST, emails are only recorded in the dashboard's Email log, not sent.
# Use the college's mail server or a transactional mail service (port 587 with STARTTLS).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
MAIL_FROM=NCIT <no-reply@ncit.edu.np>
# Where messages from the Contact page are delivered.
CONTACT_EMAIL=info@ncit.edu.np

# --- Public address (used in the sitemap and links in emails) ---
SITE_URL=https://ncit.edu.np
# Domain for the HTTPS certificate (docker-compose.tls.yml). Must point at this server.
SITE_DOMAIN=ncit.edu.np
# Port the gateway listens on when not using docker-compose.tls.yml.
HTTP_PORT=8080

# --- Access rules ---
ALLOWED_DOMAIN=ncit.edu.np
# Comma-separated; these accounts become Super Admin on their first sign-in.
SUPER_ADMIN_EMAILS=
# Heads of Department, granted on every start (department=email, comma-separated). Department codes:
# computer, it, software, ice, civil, architecture, bca, management
# e.g. HOD_ASSIGNMENTS=computer=amit.shrivastava@ncit.edu.np,civil=civil.hod@ncit.edu.np
HOD_ASSIGNMENTS=
# Role given to anyone who signs in without being invited first.
DEFAULT_ROLE=student

# --- Local development only ---
# Plain http://localhost needs COOKIE_SECURE=false. Production (https) must use true.
COOKIE_SECURE=false
# true = a "sign in as any @ncit.edu.np address" form without Google, plus demo HOD accounts
# hod.<department>@ncit.edu.np for testing. NEVER in production.
DEV_LOGIN=false
# true = keep one-time sign-in codes readable in the Email log. NEVER in production.
MAIL_KEEP_SENSITIVE=false
